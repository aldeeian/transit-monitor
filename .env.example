# Transit Monitor — environment variables
# Copy to .env and fill in real values. NEVER commit .env (it is gitignored).
# In production these are set in the Render dashboard (backend) and Vercel (dashboard),
# not in any file in this repo.

# --- Backend (Go poller + API + notifier) ---

# Postgres connection string. Local dev uses the embedded DB default
# (postgres://postgres:postgres@127.0.0.1:5433/transit?sslmode=disable).
# Production uses the Supabase SESSION POOLER connection string.
DATABASE_URL=

# Resend API key. Leave empty for dev mode (emails are written to ./.outbox
# as .html files instead of being sent). Set to a real re_... key to send mail.
RESEND_API_KEY=

# From address for outgoing email. Until a domain is verified in Resend,
# this must stay as the Resend sandbox sender.
EMAIL_FROM=Transit Monitor <onboarding@resend.dev>

# Externally reachable base URLs used to build links in emails.
PUBLIC_URL=http://127.0.0.1:8080
DASHBOARD_URL=http://127.0.0.1:3000

# API listen address. Render provides PORT; locally LISTEN_ADDR can override.
# PORT=8080
# LISTEN_ADDR=127.0.0.1:8080

# Override the GTFS-RT service alerts feed URL (defaults to Calgary's feed).
# ALERTS_URL=

# --- Dashboard (Next.js) ---
# Base URL of the backend API. Baked in at build time by Vercel.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8080
